@implements IAsyncDisposable
@inject Interop Js

<div class="composer">
    <textarea @ref="_textarea"
              class="composer-input"
              rows="1"
              aria-label="Message"
              placeholder="@Placeholder"
              disabled="@Disabled"
              value="@_text"
              @oninput="e => _text = e.Value?.ToString() ?? string.Empty"></textarea>
    @if (IsGenerating)
    {
        <FluentButton Appearance="ButtonAppearance.Primary" IconOnly="true" Shape="ButtonShape.Circular" OnClick="OnStop" Title="Stop generating" aria-label="Stop generating">
            <Icon Name="stop" Size="18" />
        </FluentButton>
    }
    else
    {
        <FluentButton Appearance="ButtonAppearance.Primary" IconOnly="true" Shape="ButtonShape.Circular" OnClick="SendAsync" Disabled="@(Disabled || string.IsNullOrWhiteSpace(_text))"
                      Title="Send (Enter)" aria-label="Send">
            <Icon Name="send" Size="18" />
        </FluentButton>
    }
</div>

@code {
    private ElementReference _textarea;
    private DotNetObjectReference<Composer>? _self;
    private IJSObjectReference? _keys;
    private string _text = "";
    private bool _sending;

    [Parameter] public bool IsGenerating { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Message LocalChat";

    /// <summary>Sends the text; returns true when it was sent, which clears the box.</summary>
    [Parameter, EditorRequired] public Func<string, Task<bool>> OnSend { get; set; } = _ => Task.FromResult(false);

    [Parameter] public EventCallback OnStop { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _keys = await Js.AttachComposerAsync(_textarea, _self);
            await _textarea.FocusAsync();
        }
    }

    /// <summary>Enter, from interop.js. Shift+Enter never gets here; it adds a newline.</summary>
    [JSInvokable]
    public Task SendFromKeyboard() => InvokeAsync(SendAsync);

    public async ValueTask DisposeAsync()
    {
        if (_keys is not null)
        {
            try
            {
                await _keys.InvokeVoidAsync("dispose");
                await _keys.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }

    private async Task SendAsync()
    {
        if (IsGenerating || Disabled || _sending || string.IsNullOrWhiteSpace(_text))
        {
            return;
        }

        _sending = true;
        try
        {
            if (await OnSend(_text))
            {
                _text = "";
            }
        }
        finally
        {
            _sending = false;
        }

        StateHasChanged();
    }
}
