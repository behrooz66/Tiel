@inherits CancellableComponent
@inject IProjectService Projects
@inject IConversationService Conversations
@inject ChangeNotifier Changes
@inject ProjectContext Context
@inject NavigationManager Navigation
@inject INotificationService Notifications
@inject IDialogService Dialogs
@inject TimeProvider Time

<nav class="sidebar-content" aria-label="Chats and settings">
    <div class="sidebar-header">
        <a class="app-name" href="">LocalChat</a>
        <HealthIndicator />
    </div>

    <div class="sidebar-section">
        <ProjectSwitcher Projects="_projects" ProjectId="Context.ProjectId" OnSelected="SwitchProject" />
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="NewChat" Class="new-chat">
            <Icon Name="plus" Size="16" /> New chat
        </FluentButton>
    </div>

    <div class="sidebar-body">
        @if (_conversations.Count == 0)
        {
            <p class="muted empty">No chats in this project yet.</p>
        }
        <ul class="conversations" aria-label="Chats">
            @foreach (var conversation in _conversations)
            {
                var active = conversation.Id == _activeConversationId;
                <li @key="conversation.Id" class="conversation @(active ? "active" : null)">
                    @if (_renamingId == conversation.Id)
                    {
                        <InlineRename Value="@conversation.Title" AriaLabel="Chat title" MaxLength="200"
                                      OnSave="title => RenameAsync(conversation, title)" OnCancel="StopRenaming" />
                    }
                    else
                    {
                        <a class="conversation-link" href="c/@conversation.Id" aria-current="@(active ? "page" : null)">
                            <span class="conversation-title">@conversation.Title</span>
                            <span class="conversation-time">@RelativeTime.Format(conversation.UpdatedAt, _now)</span>
                        </a>
                        <button type="button" id="chat-menu-@conversation.Id" class="icon-button conversation-menu"
                                aria-label="More actions for @conversation.Title" @onclick="() => OpenMenuAsync(conversation)">
                            <Icon Name="more" Size="16" />
                        </button>
                    }
                </li>
            }
        </ul>
    </div>

    <div class="sidebar-footer">
        <NavLink class="sidebar-link" href="settings">
            <Icon Name="settings" Size="18" />
            <span>Settings</span>
        </NavLink>
    </div>
</nav>

<FluentMenu @ref="_menu">
    <FluentMenuList>
        <FluentMenuItem OnClick="StartRenaming">Rename</FluentMenuItem>
        <FluentMenuItem OnClick="DeleteAsync">Delete</FluentMenuItem>
    </FluentMenuList>
</FluentMenu>

@code {
    private IReadOnlyList<ProjectDto> _projects = [];
    private IReadOnlyList<ConversationSummary> _conversations = [];
    private FluentMenu? _menu;
    private ConversationSummary? _menuConversation;
    private Guid? _renamingId;
    private Guid? _activeConversationId;
    private DateTime _now;
    private PeriodicTimer? _clock;

    protected override async Task OnInitializedAsync()
    {
        _now = Time.GetUtcNow().UtcDateTime;
        _activeConversationId = ConversationIdFrom(Navigation.Uri);
        Changes.ProjectsChanged += OnProjectsChanged;
        Changes.ConversationsChanged += OnConversationsChanged;
        Context.Changed += OnContextChanged;
        Navigation.LocationChanged += OnLocationChanged;
        _clock = new PeriodicTimer(TimeSpan.FromMinutes(1), Time);
        _ = TickAsync(_clock);

        await LoadProjectsAsync();
        await LoadConversationsAsync();
    }

    protected override void OnDispose()
    {
        Changes.ProjectsChanged -= OnProjectsChanged;
        Changes.ConversationsChanged -= OnConversationsChanged;
        Context.Changed -= OnContextChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        _clock?.Dispose();
    }

    private void SwitchProject(Guid projectId) => Navigation.NavigateTo($"p/{projectId}");

    private void NewChat() => Navigation.NavigateTo($"p/{Context.ProjectId}");

    private async Task OpenMenuAsync(ConversationSummary conversation)
    {
        _menuConversation = conversation;
        if (_menu is not null)
        {
            await _menu.OpenMenuAsync($"chat-menu-{conversation.Id}");
        }
    }

    private void StartRenaming() => _renamingId = _menuConversation?.Id;

    private void StopRenaming() => _renamingId = null;

    private async Task RenameAsync(ConversationSummary conversation, string title)
    {
        _renamingId = null;
        try
        {
            await Conversations.RenameAsync(conversation.Id, title, DisposeToken);
        }
        catch (Exception ex) when (ex.IsServiceError())
        {
            await Notifications.ShowErrorAsync(ex);
        }
    }

    private async Task DeleteAsync()
    {
        if (_menuConversation is not { } conversation)
        {
            return;
        }

        var answer = await Dialogs.ShowConfirmationAsync(
            $"This permanently deletes \"{conversation.Title}\" and its messages.", "Delete this chat?", "Delete", "Cancel");
        if (answer.Cancelled)
        {
            return;
        }

        try
        {
            await Conversations.DeleteAsync(conversation.Id, DisposeToken);
            if (conversation.Id == _activeConversationId)
            {
                Navigation.NavigateTo($"p/{conversation.ProjectId}");
            }
        }
        catch (Exception ex) when (ex.IsServiceError())
        {
            await Notifications.ShowErrorAsync(ex);
        }
    }

    private async Task LoadProjectsAsync()
    {
        _projects = await Projects.ListAsync(DisposeToken);
        if (_projects.All(p => p.Id != Context.ProjectId))
        {
            // The current project was deleted, here or in another tab.
            await Context.SetAsync(ProjectIds.General);
            if (ConversationIdFrom(Navigation.Uri) is not null || Navigation.Uri.Contains("/p/", StringComparison.Ordinal))
            {
                Navigation.NavigateTo($"p/{ProjectIds.General}");
            }
        }
    }

    private async Task LoadConversationsAsync()
    {
        try
        {
            _conversations = await Conversations.ListAsync(Context.ProjectId, DisposeToken);
        }
        catch (NotFoundException)
        {
            _conversations = [];
        }
    }

    private void OnProjectsChanged() => _ = RefreshAsync(LoadProjectsAsync);

    private void OnConversationsChanged(Guid projectId)
    {
        if (projectId == Context.ProjectId)
        {
            _ = RefreshAsync(LoadConversationsAsync);
        }
    }

    private void OnContextChanged() => _ = RefreshAsync(LoadConversationsAsync);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() =>
    {
        _activeConversationId = ConversationIdFrom(e.Location);
        StateHasChanged();
    });

    private async Task TickAsync(PeriodicTimer clock)
    {
        try
        {
            while (await clock.WaitForNextTickAsync(DisposeToken))
            {
                await InvokeAsync(() =>
                {
                    _now = Time.GetUtcNow().UtcDateTime;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>Reloads on the renderer's thread; change events arrive on the writer's thread.</summary>
    private Task RefreshAsync(Func<Task> load) => InvokeAsync(async () =>
    {
        if (IsDisposed)
        {
            return;
        }

        _now = Time.GetUtcNow().UtcDateTime;
        await load();
        StateHasChanged();
    });

    private Guid? ConversationIdFrom(string uri)
    {
        var path = Navigation.ToBaseRelativePath(uri);
        return path.StartsWith("c/", StringComparison.Ordinal) && Guid.TryParse(path.AsSpan(2, Math.Min(36, path.Length - 2)), out var id)
            ? id
            : null;
    }
}
