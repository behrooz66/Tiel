@page "/"
@inject ProjectContext Context
@inject IProjectService Projects
@inject NavigationManager Navigation

<PageTitle>Tiel</PageTitle>

@code {
    // Reopens the project this browser used last, or General.
    protected override async Task OnInitializedAsync()
    {
        var projectId = await Context.GetRememberedAsync() ?? ProjectIds.General;
        try
        {
            await Projects.GetAsync(projectId, CancellationToken.None);
        }
        catch (NotFoundException)
        {
            projectId = ProjectIds.General;
        }

        Navigation.NavigateTo($"p/{projectId}", replace: true);
    }
}
