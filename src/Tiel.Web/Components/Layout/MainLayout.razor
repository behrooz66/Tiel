@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="shell @(_drawerOpen ? "drawer-open" : "")">
    <aside class="sidebar">
        <Sidebar />
    </aside>
    <div class="scrim" @onclick="CloseDrawer"></div>

    <div class="main">
        <header class="topbar">
            <button type="button" class="icon-button" aria-label="Open the sidebar" @onclick="OpenDrawer">
                <Icon Name="menu" />
            </button>
            <span class="topbar-title">Tiel</span>
        </header>

        <main class="content">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="error-panel" role="alert">
                        <h2>Something went wrong</h2>
                        <p>This part of the page hit an unexpected error. Your chats are safe; the details are in the app log.</p>
                        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="Recover">Try again</FluentButton>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<FluentProviders />

@code {
    private ErrorBoundary? _errorBoundary;
    private bool _drawerOpen;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void OpenDrawer() => _drawerOpen = true;

    private void CloseDrawer() => _drawerOpen = false;

    private void Recover() => _errorBoundary?.Recover();

    // Navigating closes the drawer on small screens and clears an error from the previous page.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() =>
    {
        _drawerOpen = false;
        _errorBoundary?.Recover();
        StateHasChanged();
    });
}
